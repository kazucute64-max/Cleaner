<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle diagonal gradient rather than a flat fill — matches the app's dark utilitarian
     theme (see ui/theme/Color.kt: SweepBackground/SweepSurface) but reads as a designed
     surface instead of a placeholder block. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#181B20"
                android:endColor="#0A0C0F" />
        </aapt:attr>
    </path>
</vector>
