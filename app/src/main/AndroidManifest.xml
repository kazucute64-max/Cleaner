<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy storage permissions — effective on API <= 29, harmless no-ops above that -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Scoped, granular media permissions — API 33+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- All-files access for Standard Scan's deeper (still non-root) legitimate reach.
         Requested via Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION, never assumed. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Shizuku talks to us only via its ContentProvider/binder — no custom permission needed here -->

    <application
        android:name=".StorageSweepApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.StorageSweep"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StorageSweep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real foreground service (scanner/ScanForegroundService.kt) — mirrors live scan
             progress into a notification. See HANDOFF.md for what it does and doesn't cover yet
             (it observes progress; the scan coroutine itself still runs in the ViewModel). -->
        <service
            android:name=".scanner.ScanForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Not started by our own process — Shizuku launches this class inside its own
             privileged process via UserServiceArgs. exported=false + no intent-filter is
             correct: nothing but Shizuku itself is meant to bind to it. -->
        <service
            android:name=".shizuku.PrivilegedFileService"
            android:exported="false"
            android:process=":privileged" />

        <!-- Shizuku requires the host app declare this provider so rikka's ShizukuProvider
             can bind on pre-API28 (Binder-in-provider trick) and register the pipe on newer APIs. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
